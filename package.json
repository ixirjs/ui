{
	"name": "@ixirjs/ui",
	"version": "1.0.0-alpha.48",
	"description": "A modular, accessible, and extensible Svelte UI component library.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ixirjs/ui.git"
	},
	"homepage": "https://github.com/ixirjs/ui#readme",
	"bugs": {
		"url": "https://github.com/ixirjs/ui/issues"
	},
	"author": "Abdel <rioman19@gmail.com>",
	"license": "MIT",
	"packageManager": "bun@1.3.9",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint && node scripts/archive-surface.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && node scripts/sync-props.mjs --check --strict",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"storybook:dev": "storybook dev -p 6006 --no-open",
		"storybook:build": "storybook build",
		"storybook:serve": "bun x http-server ./storybook-static",
		"bench:ssr": "vite build -c scripts/bench.vite.config.ts && node .bench-out/ssr-bench.js",
		"bench:ceiling": "BENCH_ENTRY=test/perf/ceiling/ceiling-bench.ts BENCH_OUT=.bench-out/ceiling vite build -c scripts/bench.vite.config.ts && node --expose-gc .bench-out/ceiling/ceiling-bench.js",
		"bench:row": "BENCH_ENTRY=test/perf/row/row-bench.ts BENCH_OUT=.bench-out/row vite build -c scripts/bench.vite.config.ts && node --expose-gc .bench-out/row/row-bench.js",
		"bench:nesting": "BENCH_ENTRY=test/perf/nesting/nesting-bench.ts BENCH_OUT=.bench-out/nesting vite build -c scripts/bench.vite.config.ts && node --expose-gc .bench-out/nesting/nesting-bench.js",
		"bench:nesting:client": "BENCH_ENTRY=test/perf/nesting/ssr-entry.ts BENCH_OUT=.bench-out/nesting-ssr vite build -c scripts/bench.vite.config.ts && vite build -c scripts/bench-client.vite.config.ts && node scripts/bench-nesting-client.mjs",
		"profile:ssr": "BENCH_ENTRY=test/perf/profile-entry.ts BENCH_OUT=.bench-out/profile vite build -c scripts/bench.vite.config.ts && rm -f .bench-out/profile/*.cpuprofile && node --cpu-prof --cpu-prof-dir=.bench-out/profile .bench-out/profile/profile-entry.js ${LAYER:-card} && node scripts/cpuprof-report.mjs .bench-out/profile",
		"profile:alloc": "BENCH_ENTRY=test/perf/profile-entry.ts BENCH_OUT=.bench-out/profile vite build -c scripts/bench.vite.config.ts && for l in plain card collapsible datagrid menu; do node .bench-out/profile/profile-entry.js $l -600 400; done",
		"scaffold": "node scripts/scaffold.mjs",
		"sync:props": "node scripts/sync-props.mjs",
		"sync:surface": "vitest --run public-surface -u",
		"archive:surface": "node scripts/archive-surface.mjs",
		"bench:vs-shadcn": "BENCH_ENTRY=test/perf/vs-shadcn/vs-bench.ts BENCH_OUT=.bench-out/vs vite build -c scripts/bench.vite.config.ts && node --expose-gc .bench-out/vs/vs-bench.js",
		"bench:vs-shadcn:client": "BENCH_ENTRY=test/perf/vs-shadcn/ssr-entry.ts BENCH_OUT=.bench-out/vs-ssr vite build -c scripts/bench.vite.config.ts && BENCH_CLIENT_ENTRY=test/perf/vs-shadcn/vs-client.svelte.ts BENCH_CLIENT_NAME=VsBench BENCH_CLIENT_FILE=vs-client.js BENCH_CLIENT_OUT=.bench-out/vs-client vite build -c scripts/bench-client.vite.config.ts && node scripts/bench-vs-client.mjs",
		"bench:vs-shadcn:fetch": "node scripts/fetch-shadcn.mjs",
		"bench:vs-shadcn:size": "node scripts/bench-vs-size.mjs",
		"bench:vs-shadcn:ab": "node scripts/bench-vs-ab.mjs",
		"bench:vs-shadcn:own": "node scripts/bench-vs-own.mjs",
		"bench:vs-shadcn:primitives": "node scripts/bench-vs-primitives.mjs",
		"bench:workloads": "BENCH_ENTRY=test/perf/vs-shadcn/ssr-entry.ts BENCH_OUT=.bench-out/vs-ssr vite build -c scripts/bench.vite.config.ts >&2 && BENCH_STYLED=1 BENCH_CLIENT_ENTRY=test/perf/workloads/workloads.svelte.ts BENCH_CLIENT_NAME=Workloads BENCH_CLIENT_FILE=workloads.js BENCH_CLIENT_OUT=.bench-out/workloads vite build -c scripts/bench-client.vite.config.ts >&2 && node scripts/bench-workloads.mjs",
		"bench:growth": "BENCH_CLIENT_ENTRY=test/perf/growth/growth-client.svelte.ts BENCH_CLIENT_NAME=GrowthBench BENCH_CLIENT_FILE=growth-client.js BENCH_CLIENT_OUT=.bench-out/growth-client vite build -c scripts/bench-client.vite.config.ts && node scripts/bench-growth.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.md",
		"!dist/**/*.MD",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.stories.*",
		"!dist/**/*-test.svelte",
		"!dist/**/*-test.svelte.d.ts",
		"!dist/**/test/**",
		"!dist/**/*.type-test.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./components/*": {
			"types": "./dist/public/components/*.d.ts",
			"svelte": "./dist/public/components/*.js",
			"default": "./dist/public/components/*.js"
		},
		"./preset": {
			"types": "./dist/preset/index.d.ts",
			"svelte": "./dist/preset/index.js",
			"default": "./dist/preset/index.js"
		},
		"./utils": {
			"types": "./dist/public/utils.d.ts",
			"svelte": "./dist/public/utils.js",
			"default": "./dist/public/utils.js"
		},
		"./shared": {
			"types": "./dist/public/shared.d.ts",
			"svelte": "./dist/public/shared.js",
			"default": "./dist/public/shared.js"
		},
		"./experimental": {
			"types": "./dist/public/experimental.d.ts",
			"svelte": "./dist/public/experimental.js",
			"default": "./dist/public/experimental.js"
		},
		"./styles/root.css": {
			"style": "./dist/components/root/root.css",
			"svelte": "./dist/components/root/root.css",
			"default": "./dist/components/root/root.css"
		}
	},
	"peerDependencies": {
		"svelte": "^5.46.4",
		"@qrcode-js/browser": "^1.2.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.59.1",
		"@qrcode-js/browser": "^1.2.0",
		"@storybook/addon-a11y": "^10.4.6",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.4.6",
		"@storybook/sveltekit": "^10.4.6",
		"@sveltejs/adapter-netlify": "^5.2.4",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^22.19.17",
		"@vitest/browser": "^3.2.4",
		"bits-ui": "2.19.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.4.6",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^16.5.0",
		"lucide-svelte": "^1.0.1",
		"mcp-handler": "^1.1.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4",
		"prettier-plugin-tailwindcss": "^0.8",
		"publint": "^0.3.18",
		"shiki": "^3.23.0",
		"storybook": "^10.4.6",
		"svelte": "5.56.8",
		"svelte-check": "^4.4.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.2.2",
		"ts-morph": "^24.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.2",
		"vite": "^7.3.2",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^0.1.0",
		"zod": "^4.3.6"
	},
	"keywords": [
		"svelte",
		"ui",
		"component",
		"library",
		"accessibility",
		"atoms",
		"reactive",
		"typescript",
		"sveltekit",
		"design-system",
		"storybook",
		"tailwindcss",
		"dropdown",
		"combobox",
		"popover",
		"form",
		"accordion",
		"button",
		"input",
		"open source",
		"frontend",
		"web components"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"cn": "^0.2.4",
		"esm-env": "^1.2.2"
	},
	"peerDependenciesMeta": {
		"@qrcode-js/browser": {
			"optional": true
		}
	}
}
